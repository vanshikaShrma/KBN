@model KBN.Models.SubsCustom;
<form id="addSubscriberForm">
    <div class="mb-3">
        <label asp-for="username" class="form-label">User Name:</label>
        <input asp-for="username" class="form-control" />
        <span asp-validation-for="username" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="password" class="form-label">Password:</label>
        <input asp-for="password" class="form-control" />
        <span asp-validation-for="password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="customer_name" class="form-label">Customer Name:</label>
        <input asp-for="customer_name" id="customer_name" name="customer_name" class="form-control" />
        <span asp-validation-for="customer_name" class="text-danger small"></span>
    </div>

    <button class="btn btn-primary addSubscriber" type="submit">Add Subscriber</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
