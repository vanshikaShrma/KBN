@model KBN.Models.SubsCustom;
<form id="updateSubscriberForm">
    <input type="hidden" asp-for="id"/>

    <input type="hidden" asp-for="recorded_at" />

    <input type="hidden" asp-for="recorded_by" />

    <div class="mb-3">
        <label asp-for="username" class="form-label">User Name:</label>
        <input asp-for="username" class="form-control" />
        <span asp-validation-for="username" class="text-danger small"></span>
    </div>

    <div class="mb-3 position-relative">
        <label asp-for="password" class="form-label">Password:</label>
        <div class="input-group">
            <input asp-for="password" class="form-control" placeholder="Enter new password" />
            <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="password" class="text-danger small"></span>
    </div>
   
    <div class="mb-3">
        <label asp-for="customer_name" class="form-label">Customer Name:</label>
        <input asp-for="customer_name" id="customer_name" name="customer_name" class="form-control" />
        <span asp-validation-for="customer_name" class="text-danger small"></span>
    </div>
    
    <button class="btn btn-primary updateSubscriber" type="submit">Update Subscriber</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

